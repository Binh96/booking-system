// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
  engineType   = "library" 
}

datasource db {
  provider = "postgresql"
}

model users {
  id               Int        @id @default(autoincrement())
  name             String     @unique
  password         String
  email            String     @unique
  membership_level String
  status           String
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt
  bookings         bookings[]
  role             roles      @relation(references: [id], fields: [role_id])
  role_id          Int
}

model resources {
  id              Int                @id @default(autoincrement())
  name            String
  type            String
  capacity        Int
  status          String
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt
  openingHours    opening_hours[]
  bookings        bookings[]
  pricingRules    pricing_rules[]
  bookingPolicies booking_policies[]
}

model opening_hours {
  id           Int       @id @default(autoincrement())
  resource_id  resources @relation(references: [id], fields: [resources_id])
  day_of_week  String
  open_time    DateTime
  close_time   DateTime
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  resources_id Int
}

model bookings {
  id           Int       @id @default(autoincrement())
  users        users     @relation(references: [id], fields: [user_id])
  resource_id  resources @relation(references: [id], fields: [resources_id])
  start_time   DateTime
  end_time     DateTime
  status       String
  price        Float
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  user_id      Int
  resources_id Int
}

model pricing_rules {
  id           Int       @id @default(autoincrement())
  resource_id  resources @relation(references: [id], fields: [resources_id])
  rule_type    String
  priority     Int
  config       Json
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  resources_id Int
}

model booking_policies {
  id                          Int       @id @default(autoincrement())
  resource_id                 resources @relation(references: [id], fields: [resources_id])
  max_duration_minutes        Int
  min_notice_minutes          Int
  max_bookings_per_day        Int
  cancellation_window_minutes Int
  created_at                  DateTime  @default(now())
  updated_at                  DateTime  @updatedAt
  resources_id                Int
}

model roles {
  id    Int     @id @default(autoincrement())
  name  String
  users users[]
}
