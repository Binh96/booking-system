@startuml

entity users {
  * id : int
  --
  * name : string
  * password : string
  * email : date
  * membership_level : string
  * status: string
  * created_at : datetime
  * updated_at : datetime
  * role_id : int
}

entity resources {
  * id : int
  --
  * name : string
  * type: string
  * capacity: int
  * status: string
  * created_at : datetime
  * updated_at : datetime
}

entity opening_hours {
  * id : int
  --
  * resource_id : int
  * day_of_week : string
  * open_time : time
  * close_time : time
  * created_at : datetime
  * updated_at : datetime
}

entity bookings {
  * id : int
  --
  * user_id : int
  * resource_id : int
  * start_time : datetime
  * end_time : datetime
  * status : string
  * price: float
  * created_at : datetime
  * updated_at : datetime
}

entity pricing_rules {
  * id : int
  --
  * resource_id : int
  * rule_type: string
  * priority: int
  * config : text (json)
  * created_at : datetime
  * updated_at : datetime
}

entity booking_policies {
  * id : int
  --
  * resource_id : int
  * max_duration_minutes : int
  * min_notice_minutes : int
  * max_bookings_per_day: int
  * cancellation_window_minutes : int
  * created_at : datetime
  * updated_at : datetime
}

entity roles {
  * id : int
  --
  * name : string
}
