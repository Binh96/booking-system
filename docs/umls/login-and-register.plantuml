@startuml loginAndRegisterSequenceDiagram

actor User
participant "Login Page" as LoginPage
participant "Register Page" as RegisterPage
participant "Backend Server" as be
database "Database" as db

== User Login ==
User -> LoginPage: Navigate to Login Page
LoginPage -> User: Display Login Form
User -> LoginPage: Enter Credentials
LoginPage -> be: Validate Credentials
be -> db: Query User Data
db --> be: Return User Data
alt Successful
  be -> LoginPage: return success
  LoginPage -> User: Redirect to Dashboard
else Failed Login
  be -> LoginPage: return failure
  LoginPage -> User: Display Error Message
end

== User Registration ==
User -> RegisterPage: Navigate to Register Page
RegisterPage -> User: Display Registration Form
User -> RegisterPage: Enter Registration Details
RegisterPage -> RegisterPage: Validate Registration Details
alt Successful Registration
  be -> RegisterPage: return success
  be -> db: Store New User Data
  db --> be: Confirmation of Storage
  RegisterPage -> User: Redirect to Welcome Page
else Failed Registration
  be -> RegisterPage: return failure
  RegisterPage -> User: Display Error Message
end
