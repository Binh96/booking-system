{
  "openapi": "3.0.0",
  "info": {
    "title": "Booking SystemAPI",
    "version": "1.0.0"
  },
  "paths": {
    "/bookings": {
      "get": {
        "summary": "Get all bookings",
        "responses": {
          "200": {
            "description": "A list of bookings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Booking"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new booking",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostBooking"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Booking created successfully"
          },
          "400": {
            "description": "Booking is invalid"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Booking": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "customerName": {
            "type": "string",
            "example": "John Doe"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": ["Booked", "Available"]
          },
          "workingHours": {
            "type": "number",
            "description": "Working hours for the booking slot (e.g., '60 minutes')",
            "example": 60
          }
        },
        "required": ["customerName", "date", "status"]
      },
      "PostBooking": {
        "type": "object",
        "properties": {
          "customerName": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "workingHours": {
            "type": "number",
            "description": "Working hours for the booking slot (e.g., '60 minutes')",
            "example": 60
          }
        },
        "required": ["customerName", "date", "workingHours"]
      }
    }
  }
}
